{
  "name": "vibeflow",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "把软件项目变成普通人能看懂的活地图 —— 项目级代码可视化与 AI 修改工具（Claude Code 的可视化搭档）",
  "bin": {
    "vibeflow": "bin/vibeflow.js"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c yellow,cyan \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "mcp": "tsx server/mcp.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "lint": "eslint server client/src shared",
    "test": "vitest run"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xyflow/react": "^12.11.3",
    "chokidar": "^5.0.0",
    "express": "^5.2.1",
    "ignore": "^7.0.6",
    "jsonrepair": "^3.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "simple-git": "^3.36.0",
    "tree-sitter-wasms": "^0.1.13",
    "tsx": "^4.23.12",
    "typescript": "5.9",
    "web-tree-sitter": "^0.25.10",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.1",
    "playwright": "^1.62.1",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
